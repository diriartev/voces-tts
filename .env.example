# Configuración local. ./iniciar.sh crea el .env automáticamente a partir de este archivo.
# (el .env NO se sube a GitHub)

# Puerto local (solo accesible desde 127.0.0.1)
PORT=5055

# Núcleos de CPU para la clonación de voz RVC (más = más rápido)
CPUS=4.0

# Repo de GitHub de donde se descargan los modelos de voz (Releases)
MODELS_REPO=diriartev/voces-tts
MODELS_TAG=modelos-v1

# Tu usuario/grupo; ./iniciar.sh los rellena solo con `id -u` / `id -g`
APP_UID=1000
APP_GID=1000

# (Opcional) Usar la imagen YA publicada, probada y firmada por el pipeline,
# en vez de construirla en tu PC (arranca mucho más rápido). Descomenta:
# IMAGE=ghcr.io/diriartev/voces-tts:latest
